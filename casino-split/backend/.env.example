# Copier ce fichier vers .env et ajuster si besoin.

# Postgres (voir docker-compose.yml à la racine de casino-split/)
DATABASE_URL="postgresql://split:split@localhost:5432/split?schema=public"

# Redis (seeds actifs + rate limiting)
REDIS_URL="redis://localhost:6379"

# Secret JWT du stub d'auth local — À REMPLACER en production.
JWT_SECRET="dev-only-secret-change-me"

# Port d'écoute de l'API Fastify
PORT=3001
